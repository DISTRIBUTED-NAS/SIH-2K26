# =============================================================================
# ScaleGuard — Legal Metrology Officer (LMO) Field Inspection Application
# Environment Configuration Template
# =============================================================================

# Base URL for the ScaleGuard Backend Services
EXPO_PUBLIC_API_BASE_URL=https://api.scaleguard.gov.in/v1

# Environment Mode: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Session & Token Timeout (in minutes)
EXPO_PUBLIC_SESSION_TIMEOUT_MINUTES=60

# Offline Sync Interval (in milliseconds)
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000
