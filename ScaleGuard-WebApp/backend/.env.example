# ScaleGuard Backend Environment Variables Example

# Database Connection (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/scaleguard
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# JWT Configuration
# Generate a secure 256-bit or 512-bit hex/base64 key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Development Seed Users (Set to false in production)
SEED_USERS_ENABLED=true

# Server Port
PORT=8080
